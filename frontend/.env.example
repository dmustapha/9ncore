# Deployed 9ncore contract address (Ethereum Sepolia)
NEXT_PUBLIC_CONTRACT_ADDRESS=your-privlend-contract-address

# Sepolia USDC contract address (used for lend/borrow/repay flows)
NEXT_PUBLIC_USDC_ADDRESS=your-usdc-contract-address

# Sepolia chain ID (11155111)
NEXT_PUBLIC_CHAIN_ID=11155111

# Sepolia RPC URL — get a free key at https://alchemy.com
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-api-key

# Zama FHEVM Gateway for on-chain decryption requests (Sepolia)
NEXT_PUBLIC_GATEWAY_URL=https://gateway.sepolia.zama.ai
